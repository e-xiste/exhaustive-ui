{
    "name": "docs",
    "private": true,
    "version": "22.0.0-alpha.12",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "start:ssr": "ng serve --configuration=development-ssr",
        "e2e": "ng e2e",
        "lint": "ng lint",
        "build": "pnpm --filter @exhaustive-ui/themes build && npm run build:apidoc && npm run build:democode && npm run build:manifest && npm run build:llm-docs && npm run build:routes && npm run build:sitemap && ng build",
        "build:apidoc": "node scripts/build-apidoc.mjs",
        "build:routes": "node scripts/build-routes.mjs",
        "build:sitemap": "node scripts/build-sitemap.mjs",
        "build:manifest": "node scripts/build-manifest.mjs",
        "build:llm-docs": "node scripts/build-llm-docs.mjs",
        "build:democode": "node scripts/build-demo-code.mjs",
        "build:docs": "npm run build:apidoc && npm run build:democode && npm run build:manifest && npm run build:llm-docs && npm run build:routes && npm run build:sitemap && npm run test:democode && npm run test:stackblitz",
        "test:manifest": "node --test \"scripts/**/*.test.mjs\"",
        "test:democode": "node scripts/test-demo-code.mjs",
        "test:stackblitz": "node scripts/test-stackblitz-e2e.mjs --all"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/e-xiste/exhaustive-ui.git"
    },
    "devDependencies": {
        "@angular/cdk": "catalog:angular22",
        "@angular/ssr": "catalog:angular22",
        "@exhaustive-ui/core": "workspace:*",
        "@exhaustive-ui/themes": "workspace:*",
        "@openng/icons": "catalog:",
        "@stackblitz/sdk": "1.11.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "chart.js": "4.5.1",
        "express": "^5.2.1",
        "postcss": "^8.5.26",
        "prismjs": "^1.29.0",
        "quill": "2.0.3",
        "rxjs": "~7.8.2",
        "tailwindcss": "^4.3.5",
        "tslib": "^2.8.1",
        "typedoc": "0.28.20"
    },
    "dependencies": {
        "@exhaustive-ui/tailwindcss": "workspace:*"
    }
}
