{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*", "test/**/*", "tsdown.config.ts", "vitest.config.ts"],
    // v22-sync imports the schematics of @exhaustive-ui/core, which follow that package's compiler options; vitest still runs it.
    "exclude": ["node_modules", "dist", "data", "test/v22-sync.test.ts"]
}
