{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./out-tsc/app",
        // TS 6 defaults rootDir to the tsconfig dir; widen it so paths-mapped exhaustive-ui sources are allowed
        "rootDir": "../..",
        "types": ["node"],
        "strict": false,
        "paths": {
            "@exhaustive-ui/core/*": ["../../packages/core/src/*/public_api"],
            "@exhaustive-ui/motion": ["../../packages/motion/src/index"],
            "@exhaustive-ui/styled": ["../../packages/styled/src/index"],
            "@exhaustive-ui/styles": ["../../packages/styles/src/index"],
            "@exhaustive-ui/styles/*": ["../../packages/styles/src/*/index", "../../packages/styles/src/*"],
            "@exhaustive-ui/utils": ["../../packages/utils/src/index"],
            "@exhaustive-ui/utils/*": ["../../packages/utils/src/*/index", "../../packages/utils/src/*"],
            "@exhaustive-ui/themes": ["../../packages/themes/src/index"],
            "@exhaustive-ui/themes/types": ["../../packages/themes/types/index"],
            "@exhaustive-ui/themes/types/*": ["../../packages/themes/types/*/index"],
            // extension-less on purpose: resolves the tracked tokens.ts source before the generated tokens/ dir
            "@exhaustive-ui/themes/tokens": ["../../packages/themes/tokens"],
            "@exhaustive-ui/themes/*": ["../../packages/themes/src/presets/*/index", "../../packages/themes/src/presets/*"],
            "@/*": ["./*"]
        }
    },
    "include": ["../../packages/core/src/**/*.d.ts"],
    "exclude": ["node_modules", "**/node_modules", "**/dist", "**/*.spec.ts", "**/*.test.ts"],
    "files": ["app/main.ts", "server/main.server.ts", "server/server.ts", "app/polyfills.ts"],
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": false,
        "strictInputAccessModifiers": false,
        "strictTemplates": false
    }
}
